# ============================================
# COPAC API — Variables de entorno
# Copia este archivo a .env y completa los valores.
# NUNCA subas el .gitignore real a git.
# ============================================

# --- Obligatorias en producción (la app no arranca sin ellas) ---
# Supabase / Postgres
DATABASE_URL=
DB_API_KEY=

# JWT — usa un valor aleatorio largo (p. ej. openssl rand -hex 32)
SECRET_KEY=

# --- Servicios ---
# Redis (opcional en dev; en producción es OBLIGATORIO: guarda la sesión pendiente del segundo factor)
REDIS_URL=redis://localhost:6379

# Stripe (pagos)
STRIPE_SECRET_KEY=
# Secreto del endpoint de webhook (whsec_...). Sin él, POST /pagos/webhook responde 503 y los pagos no se marcan como pagados.
# Local: stripe listen --forward-to localhost:3000/pagos/webhook
STRIPE_WEBHOOK_SECRET=
# URLs de retorno del checkout (deben coincidir con tu frontend)
STRIPE_SUCCESS_URL=http://localhost:5173/pago/exito
STRIPE_CANCEL_URL=http://localhost:5173/pago/cancelado

# --- Entorno ---
# development | production | test
NODE_ENV=development
# Puerto del servidor (default 3000)
PORT=3000

# --- CORS ---
# Orígenes permitidos, separados por coma (OBLIGATORIO en producción si expone la API a un frontend)
# Ejemplo: https://tu-frontend.com,https://otro-dominio.com
CORS_ORIGINS=

# --- Supabase Auth: segundo factor (TOTP) del personal y correo de recuperación ---
# Obligatorias en producción. URL del proyecto (NO es DATABASE_URL): https://<ref>.supabase.co
SUPABASE_URL=
# Clave publicable (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_...). SOLO servidor: nunca al frontend ni al repositorio
SUPABASE_SECRET_KEY=
# Pantallas a las que apunta el enlace del correo de recuperación (deben estar en Redirect URLs de Supabase)
PASSWORD_RESET_URL_STAFF=http://localhost:5173/copac/restablecer
PASSWORD_RESET_URL_CLIENTE=http://localhost:5173/restablecer
