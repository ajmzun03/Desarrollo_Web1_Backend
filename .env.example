# ============================================
# COPAC API — Variables de entorno
# Copia este archivo a .env y completa los valores.
# NUNCA subas el .gitignore real a git.
# ============================================

# --- Obligatorias en producción (la app no arranca sin ellas) ---
# Supabase / Postgres
DATABASE_URL=
DB_API_KEY=

# JWT — usa un valor aleatorio largo (p. ej. openssl rand -hex 32)
SECRET_KEY=

# --- Servicios ---
# Redis (opcional en dev; en producción el 2FA requiere Redis)
REDIS_URL=redis://localhost:6379

# Stripe (pagos)
STRIPE_SECRET_KEY=
# Secreto del endpoint de webhook (whsec_...). Sin él, POST /pagos/webhook responde 503 y los pagos no se marcan como pagados.
# Local: stripe listen --forward-to localhost:3000/pagos/webhook
STRIPE_WEBHOOK_SECRET=
# URLs de retorno del checkout (deben coincidir con tu frontend)
STRIPE_SUCCESS_URL=http://localhost:5173/pago/exito
STRIPE_CANCEL_URL=http://localhost:5173/pago/cancelado

# --- Entorno ---
# development | production | test
NODE_ENV=development
# Puerto del servidor (default 3000)
PORT=3000

# --- CORS ---
# Orígenes permitidos, separados por coma (OBLIGATORIO en producción si expone la API a un frontend)
# Ejemplo: https://tu-frontend.com,https://otro-dominio.com
CORS_ORIGINS=

# --- SMS (Vonage) para códigos 2FA ---
SMS=
SMS_SECRET=
# Remitente del SMS: alfanumérico de 3 a 11 caracteres (por defecto APP_NAME). Guatemala admite remitente alfanumérico en Tigo y Claro
# sin registro, pero NO admite remitentes numéricos; no uses un número aquí para destinos guatemaltecos.
SMS_FROM=
# Solo desarrollo/pruebas: si se define, TODOS los códigos 2FA por SMS se envían a este número (se ignora en producción)
SMS_DESTINO_PRUEBAS=

# true = el código 2FA se envía por SMS y por correo a la vez (recomendado mientras no se confirme la entrega del SMS)
OTP_ENVIAR_AMBOS=false

# SOLO DESARROLLO: escribe el código 2FA en el log del servidor (y no falla el login si SMS y correo no funcionan).
# Se ignora siempre en producción.
OTP_MOSTRAR_EN_LOG=false

# --- Email (SMTP) para códigos 2FA (fallback si falla SMS) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM="COPAC <no-reply@tu-dominio.com>"
SMTP_USER=
SMTP_PASS=

# Nombre usado en asunto de correos/SMS
APP_NAME=COPAC

# --- AWS S3 (archivos) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# --- Operación ---
# Peticiones máximas por IP cada 15 min (default 600; una sucursal comparte IP)
RATE_LIMIT_MAX=600
# Swagger UI en /docs: siempre en desarrollo; en producción solo con ENABLE_DOCS=true
ENABLE_DOCS=false
# Nivel de log (trace|debug|info|warn|error) y escritura a ./logs/app.log en producción (por defecto solo stdout)
LOG_LEVEL=info
LOG_TO_FILE=false

# --- Seguridad ---
# Rounds de bcrypt (default 10 si no se define o es inválido)
SALT_ROUND=10
