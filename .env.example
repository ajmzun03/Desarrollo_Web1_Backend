# ============================================
# COPAC API — Variables de entorno
# Copia este archivo a .env y completa los valores.
# NUNCA subas el .gitignore real a git.
# ============================================

# --- Obligatorias en producción (la app no arranca sin ellas) ---
# Supabase / Postgres
DATABASE_URL=
DB_API_KEY=

# JWT — usa un valor aleatorio largo (p. ej. openssl rand -hex 32)
SECRET_KEY=

# --- Servicios ---
# Redis (opcional en dev; en producción el 2FA requiere Redis)
REDIS_URL=redis://localhost:6379

# Stripe (pagos)
STRIPE_SECRET_KEY=
# URLs de retorno del checkout (deben coincidir con tu frontend)
STRIPE_SUCCESS_URL=http://localhost:5173/pagos/success
STRIPE_CANCEL_URL=http://localhost:5173/pagos/cancel

# --- Entorno ---
# development | production | test
NODE_ENV=development
# Puerto del servidor (default 3000)
PORT=3000

# --- CORS ---
# Orígenes permitidos, separados por coma (OBLIGATORIO en producción si expone la API a un frontend)
# Ejemplo: https://tu-frontend.com,https://otro-dominio.com
CORS_ORIGINS=

# --- SMS (Vonage) para códigos 2FA ---
SMS=
SMS_SECRET=

# --- Email (SMTP) para códigos 2FA (fallback si falla SMS) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM="COPAC <no-reply@tu-dominio.com>"
SMTP_USER=
SMTP_PASS=

# Nombre usado en asunto de correos/SMS
APP_NAME=COPAC

# --- AWS S3 (archivos) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# --- Seguridad ---
# Rounds de bcrypt (default 10 si no se define o es inválido)
SALT_ROUND=10
