    "DIRECCIONES": {
      "201_CREATED": [
        {
          "nombre": "Crear dirección válida",
          "metodo": "POST",
          "ruta": "/direcciones",
          "headers": { "Authorization": "Bearer {{token}}", "Content-Type": "application/json" },
          "body": {
            "cliente_id": 1,
            "municipio_id": 1,
            "direccion1": "Av. Principal 123",
            "direccion2": "Casa color azul"
          }
        }
      ],
      "400_BAD_REQUEST": [
        {
          "nombre": "direccion1 muy corta (min 3)",
          "metodo": "POST",
          "ruta": "/direcciones",
          "headers": { "Authorization": "Bearer {{token}}", "Content-Type": "application/json" },
          "body": { "cliente_id": 1, "municipio_id": 1, "direccion1": "AB", "direccion2": "Casa" },
          "error_esperado": "La dirección debe tener al menos 3 caracteres"
        },
        {
          "nombre": "direccion2 muy corta (min 1)",
          "metodo": "POST",
          "ruta": "/direcciones",
          "headers": { "Authorization": "Bearer {{token}}", "Content-Type": "application/json" },
          "body": { "cliente_id": 1, "municipio_id": 1, "direccion1": "Av. Principal", "direccion2": "" },
          "error_esperado": "La dirección secundaria debe tener al menos 1 caracteres"
        },
        {
          "nombre": "Campos requeridos faltantes",
          "metodo": "POST",
          "ruta": "/direcciones",
          "headers": { "Authorization": "Bearer {{token}}", "Content-Type": "application/json" },
          "body": { "cliente_id": 1 },
          "error_esperado": "cliente_id, municipio_id, direccion1 y direccion2 son requeridos"
        }
      ]
    },

